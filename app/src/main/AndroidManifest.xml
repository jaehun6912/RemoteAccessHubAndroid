<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- 설치 여부 확인·실행 대상: 원격 데스크톱 앱(rdp:// 주소, .rdp 파일), 크롬 원격 데스크톱 앱, 브라우저 -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="rdp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/x-rdp" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="https" />
        </intent>
        <package android:name="com.google.chromeremotedesktop" />
        <package android:name="com.microsoft.rdc.androidx" />
    </queries>

    <!--
      usesCleartextTraffic: 공유기 관리자 주소는 사용자가 입력하며 대부분 http://(DDNS:원격 관리 포트)라서 막지 않는다.
      allowBackup=false: 공유기 화면의 쿠키·저장소가 백업으로 다른 기기에 옮겨지지 않도록 한다.
    -->
    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@style/Theme.RemoteAccessHub"
        android:usesCleartextTraffic="true">

        <!--
          화면 회전·크기 변경·다크 모드 전환에도 액티비티를 다시 만들지 않는다.
          공유기 화면(WebView)의 로그인 세션을 잃지 않기 위해서다.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density|fontScale|layoutDirection|locale"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
